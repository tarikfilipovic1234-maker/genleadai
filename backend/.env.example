# Copy to backend/.env and edit.  backend/.env is gitignored.

APP_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Database -------------------------------------------------------------
# Must use the "+asyncpg" driver suffix.
#
# Option A - local Postgres via Docker (docker compose up -d db):
DATABASE_URL=postgresql+asyncpg://leadgen:leadgen@localhost:5432/leadgen
#
# Option B - free Neon instance (no local install; neon.tech free tier).
# Take the connection string from the Neon dashboard, then:
#   - replace the "postgresql://" scheme with "postgresql+asyncpg://"
#   - delete any "?sslmode=require" query string (asyncpg rejects it; it
#     negotiates TLS on its own)
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb

# --- Agent ----------------------------------------------------------------
# sdk    = live Claude Agent SDK on your subscription (LOCAL ONLY)
# replay = re-emit a recorded run; no model, no credentials (used in production)
# manual = hand-written Messages API loop, fixture-driven (milestone 13)
AGENT_RUNTIME=sdk

# Leave unset to inherit whatever model Claude Code defaults to for your plan.
# CLAUDE_MODEL=claude-opus-5

AGENT_MAX_TURNS=40

# --- HTTP -----------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]

# --- Claude authentication ------------------------------------------------
# Usually you need NOTHING here: if you are logged in to the Claude Code CLI,
# the Agent SDK inherits that login automatically.
#
# Set this only for a non-interactive shell (CI, a container) - generate it with
#   claude setup-token
# CLAUDE_CODE_OAUTH_TOKEN=
#
# WARNING: never set ANTHROPIC_API_KEY in this project. The SDK prefers it over
# your subscription and would silently bill Console credits. config.py refuses
# to start if it is present.
