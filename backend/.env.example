# Copy to backend/.env and edit.  backend/.env is gitignored.

APP_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Database -------------------------------------------------------------
# Must use the "+asyncpg" driver suffix.
#
# Option A - local Postgres via Docker (docker compose up -d db):
DATABASE_URL=postgresql+asyncpg://leadgen:leadgen@localhost:5432/leadgen
#
# Option B - free Neon instance (no local install; neon.tech free tier).
# Paste the connection string from the dashboard exactly as given. config.py
# rewrites the scheme to +asyncpg and strips the libpq parameters (sslmode,
# channel_binding) that asyncpg rejects - TLS is still negotiated.
# DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Agent ----------------------------------------------------------------
# sdk    = live Claude Agent SDK on your subscription (LOCAL ONLY)
# replay = re-emit a recorded run; no model, no credentials (used in production)
# manual = hand-written Messages API loop, fixture-driven (milestone 13)
AGENT_RUNTIME=sdk

# Leave unset to inherit whatever model Claude Code defaults to for your plan.
# CLAUDE_MODEL=claude-opus-5

AGENT_MAX_TURNS=40

# --- Data providers -------------------------------------------------------
# overpass = live OpenStreetMap data (free, no API key required)
# fixture  = recorded responses from backend/fixtures/; offline and deterministic
SEARCH_PROVIDER=overpass

# OVERPASS_URL=https://overpass-api.de/api/interpreter
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# Nominatim's usage policy requires a User-Agent identifying the application
# with a contact route. Change the URL below to your own fork before deploying.
# HTTP_USER_AGENT=genleadai/0.1 (...; +https://github.com/you/genleadai)

# Both Overpass and Nominatim ask for at most one request per second.
HTTP_MIN_INTERVAL_S=1.0
HTTP_TIMEOUT_S=30.0

# Responses are cached to disk so repeated development runs never re-hit the
# donated infrastructure. Set false only to verify against live data.
HTTP_USE_CACHE=true
HTTP_CACHE_DIR=.cache/http

# --- HTTP -----------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]

# --- Claude authentication ------------------------------------------------
# Usually you need NOTHING here: if you are logged in to the Claude Code CLI,
# the Agent SDK inherits that login automatically.
#
# Set this only for a non-interactive shell (CI, a container) - generate it with
#   claude setup-token
# CLAUDE_CODE_OAUTH_TOKEN=
#
# WARNING: never set ANTHROPIC_API_KEY in this project. The SDK prefers it over
# your subscription and would silently bill Console credits. config.py refuses
# to start if it is present.
